LOTO_APP_NAME=LotoSystem
LOTO_ENVIRONMENT=development
LOTO_LOG_LEVEL=INFO
LOTO_API_PREFIX=/api

# Email notifications are optional and disabled by default.
LOTO_EMAIL_ENABLED=false
LOTO_EMAIL_FROM=
LOTO_EMAIL_TO=
LOTO_SMTP_HOST=
LOTO_SMTP_PORT=587
LOTO_SMTP_USERNAME=
LOTO_SMTP_PASSWORD=
LOTO_SMTP_USE_TLS=true
