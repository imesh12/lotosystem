# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Build artifacts
build/
dist/
*.egg-info/

# Local raw data
# Browser-downloaded Mizuho HTML/source files are not committed.
data/raw/*
!data/raw/.gitkeep

# Canonical historical datasets
# Ignore other processed files, but keep the two verified lottery histories.
data/processed/*
!data/processed/.gitkeep
!data/processed/loto6_history.csv
!data/processed/mini_loto_history.csv

# Generated research/benchmark outputs
# These can be regenerated from the canonical data and source code.
data/exports/*
!data/exports/.gitkeep

# Generated/trained models
models/*
!models/.gitkeep

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/